{
  "name": "shan-shui-gpu",
  "version": "0.1.0",
  "description": "Seeded Chinese ink landscapes generated entirely in WebGL2 shaders.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/samoojj/shan-shui-inf-gpu.git" },
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
